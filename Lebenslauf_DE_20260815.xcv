<profile>
    <name>Profil</name>
    <capability>
        <name>Principal Software Engineer / Software Architect</name>
        <item>
            Principal Software Engineer und Software Architect mit über 20 Jahren
            Erfahrung in Embedded- und Systemsoftware, mit Schwerpunkt auf C/C++
            und Linux-basierten Systemen. Umfangreiche Erfahrung in der Architektur
            und Entwicklung komplexer Embedded-Systeme sowie in der technischen
            Verantwortung für Softwareplattformen und zentrale Systementscheidungen.
        </item>
        <item>
            Erfahrung in der technischen Führung und Beratung von
            Softwareentwicklungsteams sowie im Aufbau von Build-, Integrations-
            und Entwicklungsinfrastruktur ohne disziplinarische
            Personalverantwortung.
        </item>
    </capability>
</profile>
